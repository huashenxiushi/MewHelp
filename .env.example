# Copy this file to .env, then choose an OpenAI Chat Completions-compatible upstream.
# These three fields may stay empty: /health starts, model requests remain unavailable.
# Example base URL: https://api.openai.com/v1 or http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_MODEL=
# Keep the actual API key in .env only. For a local upstream, set its required placeholder.
OPENAI_API_KEY=
# Output-limit wire field: max_tokens for compatible endpoints (default),
# or max_completion_tokens when required by the configured model. Only one is sent.
OPENAI_TOKEN_LIMIT_FIELD=max_tokens

# Explicitly select json_mode or json_schema; no automatic fallback to tool calling.
STRUCTURED_OUTPUT_METHOD=json_mode

# Reply reserve + safety margin must be strictly smaller than the context window.
CONTEXT_WINDOW_TOKENS=8192
MAX_OUTPUT_TOKENS=512
TOKEN_SAFETY_MARGIN=512
# Zero disables historical messages; the server does not store sessions.
HISTORY_MAX_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=60
SHOP_NAME=MewHelp
